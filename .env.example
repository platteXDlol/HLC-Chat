# =============================================================================
# HLC-Chat configuration
#
# Copy to .env for local development, or set as environment variables in
# Docker. Everything here is server-side only — nothing in this file is ever
# exposed to the browser.
# =============================================================================

# --- App ---------------------------------------------------------------------

# Public URL of the app (used for the OIDC redirect_uri).
PUBLIC_URL=https://chat.example.com

# --- LLM backend (server-side only) -------------------------------------------

# Base URL of your OpenAI-compatible server (llama.cpp/llama-server, vLLM,
# LM Studio, ...). The app calls <LLM_URL>/v1/models and
# <LLM_URL>/v1/chat/completions.
LLM_URL=http://localhost:8080

# Timeout (ms) for establishing a connection to the LLM before failing fast.
# LLM_TIMEOUT_MS=10000

# --- Authentik OIDC ------------------------------------------------------------

# Issuer of your Authentik application.
AUTHENTIK_ISSUER=https://auth.example.com/application/o/hlc-chat/

# Client ID of the Authentik OIDC application.
AUTHENTIK_CLIENT_ID=your-client-id

# Only required for confidential OAuth clients; omit for public clients (PKCE).
# AUTHENTIK_CLIENT_SECRET=

# --- Behavior -------------------------------------------------------------------

# Global default system prompt applied to all chats (empty by default).
# SYSTEM_PROMPT=

# SQLite database file. Volume-mount this path in Docker.
# DB_PATH=./data/hlc-chat.db
